# D3 Environment Configuration
# Copy this file to .env and fill in real values before running the server.
# Never commit .env to source control.

# ── Server ──────────────────────────────────────────────────────────────────

# Node.js environment. Use "development" locally, "production" in production.
NODE_ENV=development

# TCP port the API server listens on.
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres@localhost:5432/d3

# ── Web App / CORS ────────────────────────────────────────────────────────────

# Full origin of the web frontend. Must match exactly what the browser sends.
# Only this origin is allowed for cross-origin requests.
D3_CORS_ORIGIN=http://localhost:5173

# ── Request Limits ────────────────────────────────────────────────────────────

# Maximum request body size accepted by the API.
D3_REQUEST_BODY_LIMIT=32kb

# ── Secrets (required — must be at least 32 characters each) ─────────────────

# Secret key used to HMAC-sign QR identifiers.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
D3_QR_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Secret used as an additional HMAC key when hashing OTP challenges.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
D3_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# ── Cookie Security ───────────────────────────────────────────────────────────

# Set to "true" in production (requires HTTPS). Use "false" for local HTTP dev.
D3_SECURE_COOKIES=false

# ── Session & OTP Lifetimes (milliseconds) ────────────────────────────────────

# How long an OTP challenge remains valid after creation. Default: 10 minutes.
D3_OTP_TTL_MS=600000

# Maximum number of incorrect OTP attempts before a challenge is locked. Default: 5.
D3_OTP_MAX_ATTEMPTS=5

# How long a pre-verification session (created after QR scan) stays valid. Default: 30 minutes.
D3_PRE_SESSION_TTL_MS=1800000

# How long an authenticated customer session stays valid. Default: 8 hours.
D3_CUSTOMER_SESSION_TTL_MS=28800000

# How long an authenticated staff session stays valid. Default: 8 hours.
D3_STAFF_SESSION_TTL_MS=28800000

# ── Development Seed ──────────────────────────────────────────────────────────

# Set to "true" to insert a sample table, QR code, admin user, and menu on
# startup. Must NOT be enabled in production. Ignored when NODE_ENV=production.
D3_ENABLE_DEV_SEED=false

# ── Telegram Bug Reporting (Optional) ─────────────────────────────────────────

# Bot token from @BotFather for sending beta bug reports and user feedback.
# Format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Chat ID (group, channel, or personal chat) where bug reports will be delivered.
# Format: 123456789 or -1001234567890
TELEGRAM_CHAT_ID=
