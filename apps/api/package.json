{
  "name": "@d3/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @d3/shared",
    "build": "tsc -p tsconfig.json",
    "dev": "D3_ENABLE_DEV_SEED=true tsx watch --env-file=../../.env --conditions development src/app/server.ts",
    "test": "vitest run",
    "generate-qr": "tsx --env-file=../../.env scripts/generate-table-qrs.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "pretypecheck": "npm run build --workspace @d3/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@d3/shared": "0.1.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
