{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "d3-api",
  "main": "src/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "D3_DB",
      "database_name": "D3_DB",
      "database_id": "cc73ec7d-4fac-43a7-8f77-9eefe008a029"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CORS_ORIGIN": "https://d3-restaurant.pages.dev"
  }
}